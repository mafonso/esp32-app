# Embed every file under main/web/ and generate the table the static-file
# handler serves from (core/web_assets.h). Adding, removing or editing a file
# re-runs this automatically; no list to maintain.
#
# Outputs, for idf_component_register() in CMakeLists.txt:
#   WEB_ASSET_SRC    generated C source with the {path, start, end, mime} table
#   WEB_ASSET_FILES  files to pass to EMBED_FILES
#
# Also generates /features.json: the sorted URLs of web/features/*.js, which
# the frontend loads with import(). Dropping a file there publishes it.
#
# IDF names embedded symbols after the file name only, so each file is copied
# to build/.../web_assets/ under a name made from its whole path
# (features/sysinfo.js -> webfs_features_sysinfo_js). Two paths that map to the
# same name (e.g. a-b.js and a_b.js) fail the build.

set(web_dir "${CMAKE_CURRENT_LIST_DIR}/web")
set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/web_assets")
file(MAKE_DIRECTORY "${out_dir}")

file(GLOB_RECURSE web_paths CONFIGURE_DEPENDS RELATIVE "${web_dir}" "${web_dir}/*")
list(FILTER web_paths EXCLUDE REGEX "(^|/)\\.")   # skip .DS_Store and other dotfiles
list(SORT web_paths)

# /features.json, generated into the build dir and served like any other file.
set(feature_urls "")
foreach(path ${web_paths})
    if(path MATCHES "^features/[^/]+\\.js$")
        list(APPEND feature_urls "\"/${path}\"")
    endif()
endforeach()
list(JOIN feature_urls "," feature_json)
if("features.json" IN_LIST web_paths)
    message(FATAL_ERROR "main/web/features.json is generated; remove the file")
endif()
file(CONFIGURE OUTPUT "${out_dir}/features.json" CONTENT "[${feature_json}]\n")

set(WEB_ASSET_FILES "")
set(decls "")
set(rows "")
set(symbols "")
foreach(path ${web_paths} "features.json")
    string(MAKE_C_IDENTIFIER "webfs_${path}" sym)
    if(sym IN_LIST symbols)
        message(FATAL_ERROR "main/web/${path}: its embedded name '${sym}' clashes with another "
                            "file; rename one of them")
    endif()
    list(APPEND symbols "${sym}")

    if(path STREQUAL "features.json")
        set(src "${out_dir}/features.json")
    else()
        set(src "${web_dir}/${path}")
    endif()
    configure_file("${src}" "${out_dir}/${sym}" COPYONLY)
    list(APPEND WEB_ASSET_FILES "${out_dir}/${sym}")

    get_filename_component(ext "${path}" LAST_EXT)
    string(TOLOWER "${ext}" ext)
    if(ext STREQUAL ".html")
        set(mime "text/html; charset=utf-8")
    elseif(ext STREQUAL ".js" OR ext STREQUAL ".mjs")
        set(mime "text/javascript; charset=utf-8")
    elseif(ext STREQUAL ".css")
        set(mime "text/css; charset=utf-8")
    elseif(ext STREQUAL ".json")
        set(mime "application/json")
    elseif(ext STREQUAL ".svg")
        set(mime "image/svg+xml")
    elseif(ext STREQUAL ".png")
        set(mime "image/png")
    elseif(ext STREQUAL ".jpg" OR ext STREQUAL ".jpeg")
        set(mime "image/jpeg")
    elseif(ext STREQUAL ".ico")
        set(mime "image/x-icon")
    elseif(ext STREQUAL ".txt")
        set(mime "text/plain; charset=utf-8")
    else()
        set(mime "application/octet-stream")
    endif()

    string(APPEND decls "extern const uint8_t _binary_${sym}_start[], _binary_${sym}_end[];\n")
    string(APPEND rows "    {\"/${path}\", _binary_${sym}_start, _binary_${sym}_end, \"${mime}\"},\n")
endforeach()

set(WEB_ASSET_SRC "${CMAKE_CURRENT_BINARY_DIR}/web_assets.c")
file(CONFIGURE OUTPUT "${WEB_ASSET_SRC}" CONTENT
"// Generated by main/web_assets.cmake from main/web/. Do not edit.
#include \"web_assets.h\"

${decls}
const web_asset_t web_assets[] = {
${rows}};

const size_t web_assets_count = sizeof(web_assets) / sizeof(web_assets[0]);
")
